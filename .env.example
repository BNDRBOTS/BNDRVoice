# Public browser configuration (safe to expose)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME
APP_ORIGIN=https://voice.bndr.bot
SUPPORT_EMAIL=bndr.labs@gmail.com
APP_ENV=development
NODE_ENV=development

# Supabase injects URL and platform key sets into hosted Edge Functions.
# The shared client helper also supports legacy local CLI key variable names.
SUPABASE_PUBLISHABLE_KEYS=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEYS=sb_secret_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME
ANTHROPIC_API_KEY=replace_me
OPENAI_API_KEY=replace_me
DEEPSEEK_API_KEY=replace_me
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.6-luna
DEEPSEEK_MODEL=deepseek-v4-flash
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_MONTHLY_PRICE_ID=price_REPLACE_ME
STRIPE_ANNUAL_PRICE_ID=price_REPLACE_ME
STRIPE_WEEKLY_PRICE_ID=price_REPLACE_ME
STRIPE_METERED_PRICE_ID=price_REPLACE_ME
STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE_ME
ALLOWED_ORIGINS=https://voice.bndr.bot,http://localhost:4173
RECONCILE_TOKEN=replace_with_a_long_random_value
AUDIT_HASH_SALT=replace_with_at_least_32_random_characters
LISTEN_PORT=

# Optional transactional email. When absent, error reports remain stored
# and a prefilled mailto/copy workflow is shown to the user.
RESEND_API_KEY=re_REPLACE_ME
ERROR_REPORT_TO=bndr.labs@gmail.com
GIFT_CODE_HASHES=comma_separated_sha256_hashes
GUMROAD_PRODUCT_ID=voiceengine
